# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=pakistan_law

# Embedding Model (local, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Retrieval Settings
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.25

# App Settings
APP_NAME=PAKISTAN LAW ASSISTANT
APP_VERSION=1.0.0
DEBUG=false

# Frontend -> Backend URL (used by frontend/app.py)
# For local dev: http://localhost:8000/api/v1
# After deployment: https://your-backend.onrender.com/api/v1
API_BASE_URL=http://localhost:8000/api/v1
